#!/bin/sh
# Pre-commit gates: personal data and U+FFFD in tracked files, then markdownlint on staged Markdown.
set -eu

sh "$(git rev-parse --show-toplevel)/.githooks/check-personal-data.sh"

staged_md="$(git diff --cached --name-only --diff-filter=ACMR -- '*.md')"
if [ -n "$staged_md" ]; then
  # shellcheck disable=SC2086 # one path per word is intended
  npx --no-install markdownlint-cli2 $staged_md
fi
